  "comments": [
    {
      "type": "Line",
      "value": " legacy (experimentalDecorators) parameter decorators on binding patterns,",
      "start": 0,
      "end": 76
    },
    {
      "type": "Line",
      "value": " with type annotations and defaults, so walk-order checks exercise the",
      "start": 77,
      "end": 149
    },
    {
      "type": "Line",
      "value": " decorators-first field order on ObjectPattern, ArrayPattern,",
      "start": 150,
      "end": 213
    },
    {
      "type": "Line",
      "value": " AssignmentPattern, and BindingRestElement",
      "start": 214,
      "end": 258
    },
    {
      "type": "Line",
      "value": " a rest element carries its decorators too, and unlike every other pattern",
      "start": 451,
      "end": 527
    },
    {
      "type": "Line",
      "value": " its span grows to cover them",
      "start": 528,
      "end": 559
    }
